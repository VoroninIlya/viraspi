{
  "tasks": [
    { "label": "Create ssh tunel to remote raspi host-win",
      "type": "shell",
      "command": "C:/msys64/usr/bin/ssh.exe",
      "args": [
          "-L 2222:localhost:22", 
          "root@192.168.1.105"]},
    { "label": "Remove executable from remote raspi host-win",
      "type": "shell",
      "command": "C:/msys64/usr/bin/ssh.exe",
      "args": [
          "-N",
          "-f",
          "root@192.168.1.105",
          "rm /home/ilia/proj/viraspi/viraspi.elf"]},
    { "label": "Copi executable to remote raspi host-win",
      "type": "shell",
      "dependsOn": "Remove executable from remote raspi",
      "command": "C:/msys64/usr/bin/scp.exe",
      "args": [
          "${command:cmake.launchTargetDirectory}/viraspi.elf", 
          "root@192.168.1.105:/home/ilia/proj/viraspi/"]},
